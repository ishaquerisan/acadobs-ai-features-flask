DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acadobs

# AI Provider Configuration ("gemini" now, change to "local" in the future for Local LLM)
AI_PROVIDER=gemini
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=180

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Local LLM Configuration (for future use with Ollama, LM Studio, vLLM, etc.)
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=
