DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acadobs

# AI Provider Configuration ("local" for Local LLM, "gemini" for Google Gemini API)
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=300

# Google Gemini API Configuration
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# Local LLM Configuration (Ollama, LM Studio, vLLM, etc.)
AI_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_API_KEY=ollama

# CORS Configuration (comma-separated values, or * to allow all)
# Note: Use explicit origins in CORS_ALLOW_ORIGINS when setting CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Shared JWT Secret (must match Acadobs Node.js backend JWT_SECRET)
JWT_SECRET=change_me_to_match_acadobs_backend_jwt_secret

# Optional fallback academic-year start date (used only if schools.education_year_start is NULL)
# EDUCATION_YEAR_START=2025-06-01

# Monthly Student Performance Scoring Configuration
SCORING_CALCULATION_VERSION=1.0.0
SCORING_MAIN_TERM_KEYWORDS=main,term,main exam,term exam,term 1,term 2,term 3,midterm,mid-term,mid term,final term
SCORING_ABSENT_MARK_POLICY=exclude
SCORING_LATE_ATTENDANCE_CREDIT=1.0
SCORING_APPLY_APPROVED_LEAVE_REQUESTS=true
SCORING_HOMEWORK_DEFAULT_MAX_POINTS=5.0
SCORING_ACHIEVEMENT_SCORE_CAP=100.0
SCORING_ACHIEVEMENT_REQUIRE_SCHOOL_ACTIVITY=true
# Optional JSON school-approved co-scholastic grade mapping (leave unset to avoid unapproved grade assumptions)
# SCORING_CO_SCHOLASTIC_GRADE_MAP={"A+":95,"A":85,"B+":75,"B":65,"C":50}
SCORING_STUDENT_BATCH_SIZE=250

# Automatic Monthly Scheduler (Day 1 of every month at 00:10 local time)
PERFORMANCE_SCHEDULER_ENABLED=true
PERFORMANCE_SCHEDULER_TIMEZONE=Asia/Kolkata
PERFORMANCE_SCHEDULER_DAY=1
PERFORMANCE_SCHEDULER_HOUR=0
PERFORMANCE_SCHEDULER_MINUTE=10
PERFORMANCE_SCHEDULER_LOCK_TIMEOUT=5
PERFORMANCE_SCHEDULER_MAX_RETRIES=2
PERFORMANCE_SCHEDULER_RETRY_DELAY_SECONDS=30
